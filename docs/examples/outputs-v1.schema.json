{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL",
        "BLOCKED"
      ]
    },
    "commits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{7,40}$"
          }
        },
        "required": [
          "repo",
          "branch",
          "sha"
        ],
        "additionalProperties": false
      }
    },
    "integrate": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{7,40}$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "repo",
          "branch",
          "sha"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "shell": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "shell"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preview": {
      "type": "string",
      "format": "uri"
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "verdict",
    "commits",
    "integrate",
    "decisions",
    "actions",
    "checks",
    "notes"
  ],
  "additionalProperties": false
}
