{
  "name": "agentctl",
  "version": "0.9.0",
  "description": "Dispatcher of work orders for CLI coding agents (Claude Code, Codex): a spec file becomes a git worktree, symlinks, env and a tmux window with the agent running, watched for you.",
  "type": "module",
  "license": "MIT",
  "author": "Marcin Krzetowski",
  "keywords": [
    "agents",
    "claude-code",
    "codex",
    "tmux",
    "git-worktree",
    "cli",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Setech-pl/agentctl.git"
  },
  "homepage": "https://github.com/Setech-pl/agentctl#readme",
  "bugs": {
    "url": "https://github.com/Setech-pl/agentctl/issues"
  },
  "bin": {
    "agentctl": "bin/agentctl.ts",
    "agentctl-update": "bin/agentctl-update"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "LICENSE",
    "README.md",
    "README.pl.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "agentctl": "node --experimental-strip-types --no-warnings bin/agentctl.ts",
    "docs": "node --experimental-strip-types --no-warnings scripts/gen-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
