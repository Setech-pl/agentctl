{
  "name": "agentctl",
  "version": "0.1.0",
  "description": "Dispatcher for CLI coding agents (Claude Code, Codex): one spec file becomes a git worktree, symlinks, env and a tmux window with the agent running.",
  "type": "module",
  "license": "MIT",
  "author": "Marcin Krzetowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Setech-pl/agentctl.git"
  },
  "bin": {
    "agentctl": "bin/agentctl.ts"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "agentctl": "node --experimental-strip-types --no-warnings bin/agentctl.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  }
}
